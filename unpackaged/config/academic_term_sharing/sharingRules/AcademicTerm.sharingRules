<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Active_Academic_Terms_for_Guests</fullName>
        <accessLevel>Read</accessLevel>
        <description>Shares active academic terms with the Visualforce Test site guest user.</description>
        <label>Active Academic Terms for Guests</label>
        <sharedTo>
            <guestUser>Visualforce_Test</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>true</value>
        </criteriaItems>
    </sharingGuestRules>
</SharingRules>
